# Скопируйте в .env и заполните. Файл .env не коммитить.
DJANGO_SECRET_KEY=сгенерируйте-длинную-случайную-строку
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=stepy.example.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://stepy.example.ru

POSTGRES_DB=stepy
POSTGRES_USER=stepy
POSTGRES_PASSWORD=сложный-пароль
POSTGRES_HOST=db

# Резервный вход студентов по логину/паролю (отключить после подключения МЭШ)
STUDENT_PASSWORD_LOGIN=true

# Вход через МЭШ (СУДИР mos.ru). Значения выдаются при подключении — пока пусто, кнопка скрыта.
MESH_CLIENT_ID=
MESH_CLIENT_SECRET=
MESH_AUTHORIZE_URL=
MESH_TOKEN_URL=
MESH_USERINFO_URL=
MESH_SCOPE=openid profile email
# Названия полей в ответе userinfo (уточнить по документации СУДИР)
MESH_FIELD_ID=sub
MESH_FIELD_LAST_NAME=LastName
MESH_FIELD_FIRST_NAME=FirstName
MESH_FIELD_MIDDLE_NAME=MiddleName
MESH_FIELD_EMAIL=mail
MESH_FIELD_BIRTH_DATE=birthdate

# Web Push: сгенерируйте ключи командой  python manage.py generate_vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:it@college.ru
